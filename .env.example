# Base URL of the OpenCupid backend admin API. Must be the backend's internal
# address (Docker network), never the public or admin domain.
ADMIN_API_URL=http://backend:3000/api/admin

# Shared secret MCP clients send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Listen address
PORT=8080
HOST=0.0.0.0

# Optional comma-separated Host header allowlist (DNS rebinding protection),
# e.g. mcp.admin.example.org. Leave empty to disable.
MCP_ALLOWED_HOSTS=

# Include email / phone number fields in tool output (default: false).
EXPOSE_CONTACT_PII=false

# Upstream admin API request timeout in milliseconds.
ADMIN_API_TIMEOUT_MS=15000
